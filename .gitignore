# Python
__pycache__/
*.py[cod]
*.pyc
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/
checkpoints/
outputs/
experiments/**/outputs/

# Data & model artifacts
*.ckpt
*.pt
*.pth
*.safetensors
data/raw/
data/processed/
