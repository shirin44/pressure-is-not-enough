*.npz

# Logs & large outputs
logs/*
!logs/.gitkeep
!logs/development_log.md
wandb/
mlruns/
*.log
!experiments/**/aws_runs/**/stdout.log
!experiments/**/aws_runs/**/*_stdout.log
!experiments/**/aws_runs/**/*_stdout_v*.log
